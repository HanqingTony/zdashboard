# 本地开发用：npm run dev 会自动读取 .env
# 生产凭据放 /home/tony/zdata/zdashboard/agg.env（600），不要提交

HOST=127.0.0.1
PORT=3100
DB_PATH=./zdb.db
CHECKPOINT=throttle

# 可选：开启后浏览器首次访问 /?token=xxx
# AUTH_TOKEN=
# 可选：Host 白名单（逗号分隔、不含端口）
# ALLOWED_HOSTS=127.0.0.1,localhost,192.168.0.102

# 出境源代理
AGG_PROXY=http://127.0.0.1:12809

# 可选探针凭据
# YOUTUBE_API_KEY=
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=

# 项目台账事实源
ZPA_DIR=/home/tony/zrepo/zpa
ZREPO_DIR=/home/tony/zrepo

# 备份
# BACKUP_DIR=/home/tony/zdata/backup/zdashboard
# BACKUP_KEEP=7
