{
  "name": "zdashboard",
  "version": "0.3.0",
  "description": "zDashboard — 个人仪表盘：服务导航 / 信息聚合 / 项目台账 / Vocab",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "seed": "node src/projects/fromMarkdown.js",
    "test": "node --test",
    "backup": "node --env-file-if-exists=.env scripts/backup.js",
    "archive-legacy": "node --env-file-if-exists=.env scripts/archive-legacy.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "express": "^4.22.3",
    "fast-xml-parser": "^5.11.2",
    "undici": "^8.12.1"
  },
  "allowScripts": {
    "better-sqlite3@12.8.0": true
  }
}
